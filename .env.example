# AI Scan My Site — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to Git.

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AI Scan My Site

# ─── PageSpeed Insights API (Optional) ──────────────────────
# Obtain a free API key from Google Cloud Console → PageSpeed Insights API
# GOOGLE_PSI_API_KEY=AIzaSy...

# ─── AI Visibility API (Optional) ───────────────────────────
# Obtain a key from Azure Portal → Bing Search v7
# BING_SEARCH_API_KEY=

# ─── Stripe (Payments) ──────────────────────────────────────
# STRIPE_SECRET_KEY=sk_live_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Database (User/Scan History) ──────────────────────────
# DATABASE_URL=postgresql://user:password@host:5432/aiscanmysite

# ─── Email (Lead Capture & Reports) ────────────────────────
# RESEND_API_KEY=re_...
# FROM_EMAIL=noreply@aiscanmysite.com
# Formspree endpoint (Create free form at https://formspree.io and paste URL here)
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/xxyz1234

